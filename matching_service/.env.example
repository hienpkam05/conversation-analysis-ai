# Chạy FastAPI trực tiếp trên máy local: dùng hạ tầng bạn đã mở ở Docker.
APP_NAME=candidate-recruiter-matching
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://recruitment_user:recruitment_dev_password@localhost:5432/recruitment_ai
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Spec 004: profile va embedding. Cai them dependency [embeddings] truoc khi
# goi provider that; PhoBERT la cau hinh mac dinh cho huong nghien cuu.
EMBEDDING_PROVIDER=phobert
EMBEDDING_MODEL=vinai/phobert-base-v2
EMBEDDING_MODEL_VERSION=meanpool-v1
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=256
EMBEDDING_BATCH_SIZE=16
INSTALL_EMBEDDINGS=false

MATCHING_TOP_K=3
RETRIEVAL_TOP_N=10
STRICT_REGION=true
REQUIRE_ACTIVE_CAMPAIGN=true
DEFAULT_COLD_START_PERFORMANCE=0.50
WEIGHT_SEMANTIC=0.55
WEIGHT_CAMPAIGN=0.20
WEIGHT_PERFORMANCE=0.15
WEIGHT_WORKLOAD=0.10

# Docker Compose dùng cổng khác để không xung đột PostgreSQL/Qdrant đang chạy sẵn.
POSTGRES_HOST_PORT=5433
QDRANT_HOST_PORT=6335
QDRANT_GRPC_HOST_PORT=6336
